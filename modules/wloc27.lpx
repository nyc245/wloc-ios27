#!name=WLOC27 定位改写 · iOS 26/27
#!desc=拦截 Apple gs-loc 网络定位响应改写坐标；配合选点页或快捷指令切换，早操签到用

# ─────────────────────────────────────────────────────────────
# 把两处 USER 换成你的 GitHub 用户名（仓库名 wloc-ios27）
# 也可换成任意静态地址，例：
#   https://cdn.jsdelivr.net/gh/USER/wloc-ios27@main/scripts/wloc27.js
#   https://raw.githubusercontent.com/USER/wloc-ios27/main/scripts/wloc27.js
# ─────────────────────────────────────────────────────────────

[Script]
http-response ^https?://gs-loc[^/]*\.apple\.com(\.cn)?/clls/ script-path=https://cdn.jsdelivr.net/gh/USER/wloc-ios27@main/scripts/wloc27.js, requires-body=true, max-size=-1, timeout=20, tag=WLOC27 改写坐标
http-request ^https?://gs-loc[^/]*\.apple\.com(\.cn)?/wloc-settings/ script-path=https://cdn.jsdelivr.net/gh/USER/wloc-ios27@main/scripts/wloc27-settings.js, requires-body=true, max-size=-1, timeout=20, tag=WLOC27 设置坐标

[MITM]
hostname = gs-loc.apple.com, gs-loc-cn.apple.com
