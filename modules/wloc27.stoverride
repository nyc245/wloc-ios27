#!name=WLOC27 定位改写 · iOS 26/27
#!desc=拦截 Apple gs-loc 网络定位响应改写坐标；Stash 专用覆盖包

# ─────────────────────────────────────────────────────────────
# 把两处 USER 换成你的 GitHub 用户名（仓库名 wloc-ios27）
# ─────────────────────────────────────────────────────────────

[Script]
wloc27-response = type=http-response,pattern=^https?://gs-loc[^/]*\.apple\.com(\.cn)?/clls/,requires-body=1,max-size=0,timeout=20,script-path=https://cdn.jsdelivr.net/gh/USER/wloc-ios27@main/scripts/wloc27.js
wloc27-settings = type=http-request,pattern=^https?://gs-loc[^/]*\.apple\.com(\.cn)?/wloc-settings/,requires-body=1,max-size=0,timeout=20,script-path=https://cdn.jsdelivr.net/gh/USER/wloc-ios27@main/scripts/wloc27-settings.js

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com
